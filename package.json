{
  "name": "vuegrate",
  "version": "1.0.5",
  "description": "CLI для миграции Vue 2 → Vue 3: Options API → Composition API и обновление синтаксиса шаблонов",
  "type": "module",
  "bin": {
    "vuegrate": "./bin/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "codemod",
    "migration",
    "cli",
    "composition-api"
  ],
  "author": "sosiska",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BIGBASEDFLOPPA/vuegrate/issues"
  },
  "homepage": "https://github.com/BIGBASEDFLOPPA/vuegrate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BIGBASEDFLOPPA/vuegrate.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@vue/compiler-sfc": "^3.5.41",
    "cac": "^7.0.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1"
  }
}
